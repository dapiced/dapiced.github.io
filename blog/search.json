---
layout: null
permalink: /blog/search.json
sitemap: false
---
[
{%- for post in site.posts %}
  {%- assign plain_excerpt = post.excerpt | markdownify | strip_html | normalize_whitespace | truncate: 280 %}
  {%- assign search_excerpt = post.description | default: plain_excerpt | strip_html | normalize_whitespace %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }},
    "lang": {{ post.lang | default: "en" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "excerpt": {{ search_excerpt | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
